<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kraken_scenarios</name>
  <version>0.1.0</version>
  <description>Fault scenarios, localisation scoring and the launch test suite.</description>
  <maintainer email="emiliano.borghi@example.com">Emiliano Borghi</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>kraken_interfaces</exec_depend>
  <exec_depend>kraken_faults</exec_depend>
  <exec_depend>kraken_localisation</exec_depend>
  <exec_depend>kraken_nav</exec_depend>
  <exec_depend>kraken_sim</exec_depend>

  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
