<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kraken_faults</name>
  <version>0.1.0</version>
  <description>Runtime sensor fault injection for localisation robustness testing.</description>
  <maintainer email="emiliano.borghi@example.com">Emiliano Borghi</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>kraken_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
