# SPDX-License-Identifier: BSD-3-Clause
#
# Localisation + fault-injection + scenario stack, without O3DE.
#
# This is the image the integration tests run in. It has no GPU or graphics
# dependency, so it runs anywhere. Pair it with Dockerfile.Simulation when
# you want the O3DE scene instead of the headless sim.
#
#   base   dependencies only
#   dev    base + editor tooling, used by .devcontainer (sources are mounted)
#   stack  base + a baked build of ros2_ws, used by docker compose
#
# `stack` is last, so a build with no --target gives you that and skips `dev`.

ARG ROS_VERSION=jazzy
ARG UBUNTU_VERSION=noble

FROM ros:${ROS_VERSION}-ros-base-${UBUNTU_VERSION} AS base

ENV WORKSPACE=/data/workspace
ENV KRAKEN_WS=$WORKSPACE/ros2_ws
ENV LANG=en_US.UTF-8
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# CycloneDDS defaults to multicast discovery, which is unreliable inside
# containers. Everything in this image is single-host, so keep it on loopback.
# Shared with Dockerfile.Simulation: the two must agree or cross-container
# discovery works only by accident.
ENV CYCLONEDDS_URI=/etc/cyclonedds.xml
COPY docker/cyclonedds.xml /etc/cyclonedds.xml

WORKDIR $WORKSPACE

RUN apt-get update \
    && DEBIAN_FRONTEND="noninteractive" apt-get -y install --no-install-recommends \
        locales \
        python3-pip \
        python3-pytest \
        python3-colcon-common-extensions \
        ros-${ROS_DISTRO}-cyclonedds \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-robot-localization \
        ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-tf-transformations \
        ros-${ROS_DISTRO}-nav2-behaviors \
        ros-${ROS_DISTRO}-nav2-bt-navigator \
        ros-${ROS_DISTRO}-nav2-controller \
        ros-${ROS_DISTRO}-nav2-lifecycle-manager \
        ros-${ROS_DISTRO}-nav2-mppi-controller \
        ros-${ROS_DISTRO}-nav2-planner \
        ros-${ROS_DISTRO}-nav2-smac-planner \
        ros-${ROS_DISTRO}-launch-testing \
        ros-${ROS_DISTRO}-launch-testing-ros \
        ros-${ROS_DISTRO}-launch-pytest \
    && sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && dpkg-reconfigure --frontend=noninteractive locales \
    && update-locale LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Guarded, because the overlay only exists once the workspace has been built.
RUN echo ". /opt/ros/${ROS_DISTRO}/setup.bash" >> /etc/bash.bashrc \
    && echo "if [ -f $KRAKEN_WS/install/setup.bash ]; then . $KRAKEN_WS/install/setup.bash; fi" \
        >> /etc/bash.bashrc

WORKDIR $KRAKEN_WS
CMD ["/bin/bash"]


# --- dev ---------------------------------------------------------------------
# Interactive image for .devcontainer. Sources are bind-mounted rather than
# copied, so nothing is built here.

FROM base AS dev

ARG USERNAME=ubuntu

RUN apt-get update \
    && DEBIAN_FRONTEND="noninteractive" apt-get -y install --no-install-recommends \
        bash-completion \
        gdb \
        git \
        less \
        mesa-utils \
        nano \
        openssh-client \
        pciutils \
        ros-dev-tools \
        ros-${ROS_DISTRO}-rqt-plot \
        ros-${ROS_DISTRO}-rviz2 \
        sudo \
        vim \
        vulkan-tools \
    && rm -rf /var/lib/apt/lists/*

# VS Code rewrites this user's uid/gid to match the host on first start, so
# files created in the bind mount come back owned by you and not by root.
RUN echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && mkdir -p $KRAKEN_WS \
    && chown -R $USERNAME:$USERNAME $WORKSPACE

USER $USERNAME


# --- stack -------------------------------------------------------------------
# Default target: sources baked in and built. What docker compose uses.

FROM base AS stack

COPY ros2_ws/src $KRAKEN_WS/src

RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && cd $KRAKEN_WS \
    && colcon build --symlink-install --event-handlers console_direct+
