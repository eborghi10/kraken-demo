# SPDX-License-Identifier: BSD-3-Clause
#
# O3DE runtime environment. Dependencies only -- the engine, the ROS 2 Gem and
# the project are NOT baked into the image.
#
# Baking them in costs roughly twice the disk, because the LFS clone layer and
# the build tree layer both persist, and it turns every project change into a
# multi-hour rebuild with no incremental linking. Instead /o3de is bind-mounted
# from the host, populated once by docker/o3de-setup.sh, and rebuilt
# incrementally after that.
#
#   docker compose -f docker/docker-compose.yml build sim
#   docker compose -f docker/docker-compose.yml run --rm sim
#   ./docker/o3de-setup.sh        # inside the container, first run only
#
# Running this needs a GPU, the NVIDIA container toolkit, and `xhost +local:`
# on the host. The scenario tests need none of it -- use Dockerfile.Stack.

ARG ROS_VERSION=jazzy
ARG UBUNTU_VERSION=noble

FROM ros:${ROS_VERSION}-ros-base-${UBUNTU_VERSION}

ENV WORKSPACE=/data/workspace
ENV LANG=en_US.UTF-8
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Same file as Dockerfile.Stack. O3DE runs here while the ROS stack runs in the
# other container, so both ends of discovery have to be configured identically.
ENV CYCLONEDDS_URI=/etc/cyclonedds.xml
COPY docker/cyclonedds.xml /etc/cyclonedds.xml

# Bind-mount targets, not image contents. o3de-setup.sh populates them.
ENV O3DE_ROOT=/o3de/engine
ENV O3DE_EXTRAS_ROOT=/o3de/extras
ENV KRAKEN_PROJECT=$WORKSPACE/Project
ENV KRAKEN_WS=$WORKSPACE/ros2_ws

ARG USERNAME=ubuntu

# gazebo-msgs is not here because anything uses Gazebo. The ROS 2 Gem gates its
# spawner and contact sensor behind find_package(gazebo_msgs) and prints
# "disabling legacy features" when it is absent, which would leave the orchard
# unable to spawn Krakens -- ROSConDemo drives spawning over
# gazebo_msgs/srv/SpawnEntity. Dropping it means re-authoring the level prefabs
# against the SimulationInterfaces gem instead.
#
# radar-msgs is a runtime requirement of the RGL (Robotec GPU Lidar) gem.
RUN apt-get update \
    && DEBIAN_FRONTEND="noninteractive" apt-get -y install --no-install-recommends \
        binutils clang cmake curl gdb git git-lfs ninja-build pkg-config \
        libglu1-mesa-dev mesa-common-dev \
        libcurl4-openssl-dev libsdl2-dev zlib1g-dev \
        libunwind-dev libzstd-dev libssl-dev \
        libfontconfig1-dev libpcre2-16-0 \
        libxcb-xinerama0 libxcb-xkb-dev libxcb-xfixes0-dev \
        libxcb-xinput-dev libxcb-xinput0 \
        libxcb-randr0-dev libxcb-shape0-dev libxcb-sync-dev \
        libxcb-shm0-dev libxcb-glx0-dev libxcb-util-dev \
        libxcb-image0-dev libxcb-keysyms1-dev libxcb-icccm4-dev \
        libxcb-render-util0-dev libxcb-cursor-dev \
        libx11-xcb-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
        libxkbcommon-x11-dev libxkbcommon-dev \
        libx11-6 libxext6 \
        libvulkan1 vulkan-tools \
        locales python3-pip software-properties-common sudo \
        python3-colcon-common-extensions \
        python3-simplejson \
        ros-${ROS_DISTRO}-ackermann-msgs \
        ros-${ROS_DISTRO}-control-toolbox \
        ros-${ROS_DISTRO}-cyclonedds \
        ros-${ROS_DISTRO}-gazebo-msgs \
        ros-${ROS_DISTRO}-radar-msgs \
        ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
        ros-${ROS_DISTRO}-robot-localization \
        ros-${ROS_DISTRO}-rviz2 \
        ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-tf-transformations \
        ros-${ROS_DISTRO}-urdfdom \
        ros-${ROS_DISTRO}-vision-msgs \
    && sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && dpkg-reconfigure --frontend=noninteractive locales \
    && update-locale LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Files created in the bind mounts come back owned by whoever ran the build, so
# build as uid 1000 rather than root. `ubuntu` already holds uid 1000 in Noble,
# but the gid is remapped too: iceoryx scopes its shared memory to the creating
# group, so this must match the other images and the host. Declared here rather
# than at the top so that changing them does not rebuild the apt layer.
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupmod -o -g $USER_GID $USERNAME \
    && usermod -o -u $USER_UID -g $USER_GID $USERNAME \
    && echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && mkdir -p /o3de \
    && chown -R $USERNAME:$USERNAME /o3de

RUN echo ". /opt/ros/${ROS_DISTRO}/setup.bash" >> /etc/bash.bashrc \
    && echo "if [ -f $KRAKEN_WS/install/setup.bash ]; then . $KRAKEN_WS/install/setup.bash; fi" \
        >> /etc/bash.bashrc

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all

USER $USERNAME
WORKDIR $WORKSPACE
CMD ["/bin/bash"]
