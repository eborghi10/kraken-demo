// SPDX-License-Identifier: BSD-3-Clause
//
// Reuses the `dev` stage of docker/Dockerfile.Stack, so the devcontainer and the
// test image share one dependency list. The repository is mounted at
// /data/workspace to match the paths used by docker-compose.yml and the images.
{
  "name": "kraken-demo (ROS 2 Jazzy)",

  "build": {
    "context": "..",
    "dockerfile": "../docker/Dockerfile.Stack",
    "target": "dev"
  },

  "workspaceMount": "source=${localWorkspaceFolder},target=/data/workspace,type=bind",
  "workspaceFolder": "/data/workspace",
  "remoteUser": "ubuntu",
  // Default true; spelled out because iceoryx scopes its shared memory to the
  // creating gid, so this container and the compose ones have to agree.
  "updateRemoteUserUID": true,

  // Docker CLI talking to the host daemon, so the sim container can be built
  // and driven from in here. This grants root-equivalent access to the host.
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  // host networking and IPC match docker-compose.yml; the X11 socket is there
  // so rviz2 and rqt_plot work.
  // --gpus all requires nvidia-container-toolkit on the host; without it the
  // container will not start.
  "runArgs": ["--network=host", "--ipc=host", "--gpus", "all", "-v", "/tmp:/tmp"],
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    // Copilot keeps its per-workspace memory under here, which otherwise lives
    // in the container's writable layer and dies with every rebuild.
    "source=kraken-demo-workspace-storage,target=/home/ubuntu/.vscode-server/data/User/workspaceStorage,type=volume"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    // --gpus all alone grants only compute+utility; Vulkan/GLX need graphics.
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "all"
  },

  // gh needs no setup here: with no keyring in the container it falls back to a
  // plaintext token in ~/.config/gh, so `gh auth login` once per rebuild is all
  // it takes. Do not bind-mount the host's ~/.config/gh - the host does have a
  // keyring, so that file holds no token and only shadows this one.

  "postCreateCommand": ".devcontainer/post-create.sh",
  "postStartCommand": ".devcontainer/ensure-roudi.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.analysis.extraPaths": [
          "/opt/ros/jazzy/lib/python3.12/site-packages",
          "${workspaceFolder}/ros2_ws/src/kraken_faults",
          "${workspaceFolder}/ros2_ws/src/kraken_scenarios",
          "${workspaceFolder}/ros2_ws/src/kraken_sim"
        ],
        "python.testing.pytestEnabled": false,
        "files.watcherExclude": {
          "**/build/**": true,
          "**/install/**": true,
          "**/log/**": true
        },
        "search.exclude": {
          "**/build": true,
          "**/install": true,
          "**/log": true
        }
      }
    }
  }
}
